{
  "name": "@pixi-react-provisional/react-19",
  "version": "0.0.0",
  "private": true,
  "description": "React 19 adapters (React19Adapter) for the modular renderer. One subpath per audited React 19 epoch, each bundling its exact react-reconciler. No Pixi dependency.",
  "license": "MIT",
  "type": "commonjs",
  "exports": {
    "./19.0": {
      "import": {
        "types": "./dist/19.0/index.d.mts",
        "default": "./dist/19.0/index.mjs"
      },
      "require": {
        "types": "./dist/19.0/index.d.ts",
        "default": "./dist/19.0/index.js"
      }
    },
    "./19.1": {
      "import": {
        "types": "./dist/19.1/index.d.mts",
        "default": "./dist/19.1/index.mjs"
      },
      "require": {
        "types": "./dist/19.1/index.d.ts",
        "default": "./dist/19.1/index.js"
      }
    },
    "./19.2": {
      "import": {
        "types": "./dist/19.2/index.d.mts",
        "default": "./dist/19.2/index.mjs"
      },
      "require": {
        "types": "./dist/19.2/index.d.ts",
        "default": "./dist/19.2/index.js"
      }
    },
    "./19.3": {
      "import": {
        "types": "./dist/19.3/index.d.mts",
        "default": "./dist/19.3/index.mjs"
      },
      "require": {
        "types": "./dist/19.3/index.d.ts",
        "default": "./dist/19.3/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "node scripts/build.mjs",
    "check:graph": "node ../../scripts/check-dependency-graph.mjs --allow @pixi-react-provisional/core --allow react",
    "lint": "eslint --max-warnings 0 .",
    "test:unit": "tsc --noEmit -p tsconfig.json && vitest run && pnpm run check:graph",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@pixi-react-provisional/core": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.13.1",
    "@types/react": "19.3.0",
    "esbuild": "0.21.5",
    "eslint": "^9.16.0",
    "its-fine": "2.1.1",
    "jsdom": "^25.0.0",
    "react": "19.3.0",
    "react-reconciler-0.31": "npm:react-reconciler@0.31.0",
    "react-reconciler-0.32": "npm:react-reconciler@0.32.0",
    "react-reconciler-0.33": "npm:react-reconciler@0.33.0",
    "react-reconciler-0.34": "npm:react-reconciler@0.34.0",
    "typescript": "^5.4.5",
    "vitest": "^2.0.0"
  },
  "peerDependencies": {
    "react": "19.0.0 || 19.0.8 || 19.1.0 || 19.1.9 || 19.2.0 || 19.2.8 || 19.3.0"
  }
}
