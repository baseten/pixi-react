{
  // Type-checks the sources (not the tests) against the newest pixi.js in the peer range, so declarations that
  // compile against the 8.2.6 floor are also checked against 8.22.
  "extends": "./tsconfig.build.json",
  "compilerOptions": {
    "noEmit": true,
    "rootDir": ".",
    "types": [],
    "paths": {
      "pixi.js": ["./node_modules/pixi.js-current/lib/index.d.ts"]
    }
  },
  "include": ["src/**/*"]
}
