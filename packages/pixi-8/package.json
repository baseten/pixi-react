{
  "name": "@pixi-react-provisional/pixi-8",
  "version": "0.0.0",
  "private": true,
  "description": "Pixi8Adapter: the Pixi 8 adapter. Owns every pixi.js import, node construction, props, destruction, application lifecycle, ticker and Pixi globals. No React dependency.",
  "license": "MIT",
  "type": "commonjs",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.mts",
        "default": "./dist/esm/index.mjs"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/cjs/index.js",
  "types": "./dist/cjs/index.d.ts",
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "dualPackage": {
    "peerBinding": {
      "peer": "pixi.js",
      "module": "bind.js",
      "bind": "bindPixi"
    }
  },
  "scripts": {
    "build": "node ../../scripts/build-dual-package.mjs",
    "check:graph": "node ../../scripts/check-dependency-graph.mjs --allow @pixi-react-provisional/core --allow pixi.js",
    "lint": "eslint --max-warnings 0 .",
    "test:conformance": "vitest run --workspace vitest.browser.workspace.mts --project 'conformance*'",
    "test:e2e": "vitest run --workspace vitest.browser.workspace.mts",
    "test:unit": "tsc --noEmit -p tsconfig.json && vitest run && pnpm run check:graph",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.current.json"
  },
  "dependencies": {
    "@pixi-react-provisional/core": "workspace:*"
  },
  "peerDependencies": {
    "pixi.js": ">=8.2.6 <8.5.0 || >=8.5.1 <8.23.0"
  },
  "devDependencies": {
    "@pixi-react-provisional/conformance": "workspace:*",
    "@pixi-react-provisional/renderer": "workspace:*",
    "@types/node": "^22.13.1",
    "@types/react": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.1",
    "@vitest/browser": "^2.0.4",
    "eslint": "^9.16.0",
    "its-fine": "^2.0.0",
    "jsdom": "^25.0.0",
    "pixi.js": "8.2.6",
    "pixi.js-8.9": "npm:pixi.js@8.9.2",
    "pixi.js-current": "npm:pixi.js@8.22.0",
    "playwright": "^1.45.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-reconciler": "0.31.0",
    "typescript": "^5.4.5",
    "vite": "^5.0.0",
    "vitest": "^2.0.0"
  }
}
