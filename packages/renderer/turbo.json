{
  "$schema": "https://turborepo.com/schema.json",
  "extends": ["//"],
  "tasks": {
    "build": {
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/scripts/build-dual-package.mjs"],
      "outputs": ["dist/**"]
    },
    "typecheck": {
      "dependsOn": ["build", "^build"]
    },
    "test:unit": {
      "dependsOn": ["build", "^build"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/scripts/**"]
    }
  }
}
