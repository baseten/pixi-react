{
  "name": "@pixi-react-provisional/renderer",
  "version": "0.0.0",
  "private": true,
  "description": "The neutral createRenderer({ react, pixi }) composition factory. Depends only on @pixi-react-provisional/core; no global JSX declarations.",
  "license": "MIT",
  "type": "commonjs",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.mts",
        "default": "./dist/esm/index.mjs"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/cjs/index.js",
  "types": "./dist/cjs/index.d.ts",
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "node ../../scripts/build-dual-package.mjs",
    "check:graph": "node ../../scripts/check-dependency-graph.mjs --allow @pixi-react-provisional/core",
    "lint": "eslint --max-warnings 0 .",
    "test:unit": "tsc --noEmit -p tsconfig.json && vitest run && pnpm run check:graph",
    "typecheck": "tsc --noEmit -p tsconfig.json && node scripts/check-consumer-types.mjs"
  },
  "dependencies": {
    "@pixi-react-provisional/core": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.13.1",
    "eslint": "^9.16.0",
    "jsdom": "^25.0.0",
    "typescript": "^5.4.5",
    "vitest": "^2.0.0"
  }
}
