{
  "name": "@pixi/react",
  "version": "0.0.0-development",
  "description": "Write PixiJS applications using React declarative style.",
  "keywords": [
    "react",
    "pixi"
  ],
  "homepage": "https://github.com/pixijs/pixi-react#readme",
  "bugs": {
    "url": "https://github.com/pixijs/pixi-react/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pixijs/pixi-react.git"
  },
  "license": "MIT",
  "exports": {
    ".": {
      "import": {
        "types": "./types/index.d.ts",
        "default": "./lib/index.mjs"
      },
      "require": {
        "types": "./types/index.d.ts",
        "default": "./lib/index.js"
      }
    }
  },
  "main": "lib/index.js",
  "module": "lib/index.mjs",
  "types": "types/index.d.ts",
  "files": [
    "lib",
    "dist",
    "types"
  ],
  "scripts": {
    "build": "rimraf dist lib types && rollup -c && node scripts/write-esm-entry.mjs && tsc",
    "clean": "xs clean",
    "docs": "xs docs",
    "lint": "xs lint",
    "lint:fix": "xs lint --fix",
    "prerelease": "pnpm run test:lint && pnpm run build",
    "release": "xs bump,publish,git-push",
    "test": "tsc --project tsconfig.test.json && vitest run",
    "test:conformance": "tsc --project tsconfig.test.json && vitest run conformance",
    "test:e2e": "tsc --project tsconfig.test.json && vitest run e2e conformance",
    "test:unit": "tsc --project tsconfig.test.json && vitest run unit && node scripts/check-dual-entry.mjs",
    "test:lint": "xs lint",
    "test:watch": "vitest",
    "test:types": "tsc --noEmit --emitDeclarationOnly false",
    "typecheck": "tsc --noEmit --emitDeclarationOnly false"
  },
  "dependencies": {
    "@pixi-react-provisional/core": "workspace:*",
    "@pixi-react-provisional/pixi-8": "workspace:*",
    "@pixi-react-provisional/react-19": "workspace:*",
    "@pixi-react-provisional/renderer": "workspace:*",
    "react-reconciler": "0.31.0"
  },
  "devDependencies": {
    "@pixi-react-provisional/conformance": "workspace:*",
    "@pixi/extension-scripts": "^4.0.0",
    "@rollup/plugin-commonjs": "^25.0.8",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^15.2.3",
    "@testing-library/jest-dom": "^6.4.8",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/react-reconciler": "^0.28.9",
    "@vitejs/plugin-react": "^4.3.1",
    "@vitest/browser": "^2.0.4",
    "eslint": "^9.16.0",
    "jsdom": "^25.0.0",
    "pixi.js": "8.2.6",
    "playwright": "^1.45.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "rimraf": "^3.0.2",
    "rollup": "^4.18.0",
    "rollup-plugin-esbuild": "^6.1.1",
    "rollup-plugin-inject-process-env": "^1.3.1",
    "rollup-plugin-peer-deps-external": "^2.2.4",
    "rollup-plugin-sourcemaps": "^0.6.3",
    "typescript": "^5.4.5",
    "vite": "^5.0.0",
    "vitest": "^2.0.0"
  },
  "peerDependencies": {
    "pixi.js": ">=8.2.6 <8.5.0 || >=8.5.1 <8.23.0",
    "react": "19.3.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "extensionConfig": {
    "lint": [
      "test",
      "src"
    ],
    "environments": [
      "node"
    ],
    "docsName": "PixiJS React",
    "docsTitle": "PixiJS React API Documentation",
    "docsDescription": "Documentation for PixiJS React library",
    "docsKeyword": "docs, documentation, pixi, pixijs, react, html5, javascript, jsdoc"
  }
}
