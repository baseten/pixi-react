{
  "name": "@pixi-react-provisional/conformance",
  "version": "0.0.0",
  "private": true,
  "description": "Renderer conformance scenarios, a fake scene backend and a runner that binds them to a React/scene composition. Not published.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./fake-scene": "./src/fake-scene/index.ts",
    "./fake-scene-adapter": "./src/fake-scene/adapter.ts",
    "./fake-react-framework": "./src/fake-react/framework.tsx",
    "./fake-probe": "./test/fake-binding/probe.ts"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "lint": "eslint --max-warnings 0 .",
    "test:conformance": "vitest run test/core.conformance.test.tsx",
    "test:unit": "tsc --noEmit -p tsconfig.json && vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@pixi-react-provisional/core": "workspace:*"
  },
  "devDependencies": {
    "@pixi-react-provisional/renderer": "workspace:*",
    "@types/react": "^19.0.0",
    "@types/react-dom": "~19.0.0",
    "@types/react-reconciler": "^0.28.9",
    "@vitejs/plugin-react": "^4.3.1",
    "@vitest/browser": "^2.0.4",
    "eslint": "^9.16.0",
    "its-fine": "^2.0.0",
    "jsdom": "^25.0.0",
    "playwright": "^1.45.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-reconciler": "0.31.0",
    "typescript": "^5.4.5",
    "vite": "^5.0.0",
    "vitest": "^2.0.0"
  },
  "peerDependencies": {
    "react": "^18.3.1 || ^19.0.0",
    "react-dom": "^18.3.1 || ^19.0.0",
    "vitest": "^2.0.0"
  }
}
