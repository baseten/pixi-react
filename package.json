{
  "name": "pixi-react-workspace",
  "version": "0.0.0",
  "private": true,
  "description": "pnpm workspace for the baseten/pixi-react fork. The published library lives in packages/react.",
  "license": "MIT",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": "^22.22.0"
  },
  "scripts": {
    "build": "turbo run build --filter=!docs",
    "build:docs": "turbo run build --filter=docs",
    "deploy": "pnpm --filter docs run deploy",
    "start:docs": "pnpm --filter docs run start",
    "lint": "turbo run lint",
    "lint:fix": "pnpm --filter @pixi/react run lint:fix && pnpm --filter docs run lint --fix",
    "prepare": "husky install",
    "test": "turbo run test:unit test:e2e",
    "test:compatibility": "node design/compatibility/cells/run-cells.mjs all --tier pr",
    "test:contract": "pnpm --filter @pixi-react-provisional/design-contract test:contract",
    "test:conformance": "turbo run test:conformance",
    "test:e2e": "turbo run test:e2e",
    "test:examples": "turbo run test:examples",
    "test:unit": "turbo run test:unit",
    "test:lint": "turbo run lint",
    "test:types": "turbo run typecheck --filter=!docs",
    "changeset": "changeset",
    "release:policy": "node scripts/release/policy.mjs",
    "release:version": "node scripts/release/version.mjs",
    "release:stage": "node scripts/release/stage.mjs",
    "release:dry-run": "node scripts/release/dry-run.mjs",
    "test:release": "node --test scripts/release/*.test.mjs && node scripts/release/policy.mjs"
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "lint-staged": {
    "*.{ts,js,mjs}": [
      "eslint --cache --fix --max-warnings 0 --no-warn-ignored"
    ]
  },
  "devDependencies": {
    "@changesets/cli": "2.31.1",
    "@pixi/eslint-config": "^6.0.0",
    "eslint": "^9.16.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "husky": "^8.0.0",
    "pkg-pr-new": "0.0.54",
    "turbo": "2.11.3",
    "typescript": "^5.4.5"
  }
}
