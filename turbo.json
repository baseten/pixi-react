{
  "$schema": "https://turborepo.com/schema.json",
  "globalDependencies": [".nvmrc"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "lib/**", "types/**", "build/**"]
    },
    "lint": {
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/eslint.config.mjs"],
      "outputs": []
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "test:unit": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "test:e2e": {
      "dependsOn": ["^build"],
      "cache": false,
      "passThroughEnv": ["CI", "DISPLAY", "PLAYWRIGHT_BROWSERS_PATH"],
      "outputs": []
    },
    "test:conformance": {
      "dependsOn": ["^build"],
      "cache": false,
      "passThroughEnv": ["CI", "DISPLAY", "PLAYWRIGHT_BROWSERS_PATH"],
      "outputs": []
    }
  }
}
