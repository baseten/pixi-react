{
  "name": "@pixi-react-provisional/examples",
  "version": "0.0.0",
  "private": true,
  "description": "Private, never published: the deterministic docs examples as a standalone Vite app, built against the local workspace facade (@pixi/react) and the createRenderer composition. The docs embed the same source files; issue 19's Playwright browser and visual tests use the routes as fixtures. See README.md.",
  "license": "MIT",
  "type": "module",
  "exports": {
    "./catalog.json": "./src/catalog.json",
    "./harness/strip": {
      "types": "./src/harness/strip.d.ts",
      "default": "./src/harness/strip.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check:bundle": "node scripts/check-bundle.mjs",
    "lint": "eslint --max-warnings 0 .",
    "test:examples": "node scripts/check-bundle.mjs && playwright test --project=functional --project=visual && node scripts/check-report.mjs --require functional --require visual",
    "test:examples:dev": "node scripts/run-e2e.mjs dev",
    "test:examples:webgpu": "node scripts/run-e2e.mjs webgpu",
    "test:examples:update": "playwright test --project=visual --update-snapshots",
    "test:unit": "node --test test/*.test.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p e2e/tsconfig.json"
  },
  "dependencies": {
    "@pixi-react-provisional/pixi-8": "workspace:*",
    "@pixi-react-provisional/react-19.3": "workspace:*",
    "@pixi-react-provisional/renderer": "workspace:*",
    "@pixi/react": "workspace:*",
    "pixi.js": "8.22.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "1.50.1",
    "@types/node": "^22.13.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "eslint": "^9.16.0",
    "typescript": "^5.4.5",
    "vite": "^5.0.0"
  }
}
