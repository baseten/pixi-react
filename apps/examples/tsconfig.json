{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "allowJs": true,
    "checkJs": false,
    "types": [
      "vite/client"
    ],
    "paths": {
      "pixi.js": [
        "./node_modules/pixi.js"
      ]
    }
  },
  "include": [
    "src/**/*",
    "vite.config.ts"
  ]
}
